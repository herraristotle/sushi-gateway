# Sushi Gateway Configuration

# Gateway Configuration Path (REQUIRED)
CONFIG_FILE_PATH="./config/config.yaml"

# Admin API Credentials (REQUIRED)
ADMIN_USER="admin"
ADMIN_PASSWORD="changeme"

# Redis Configuration (REQUIRED for distributed rate limiting and caching)
REDIS_ADDR="localhost:6379"
REDIS_PASSWORD=""

# TLS Configuration (Optional - auto-generated if not provided)
# SERVER_CERT_PATH="./config/server.crt"
# SERVER_KEY_PATH="./config/server.key"
# CA_CERT_PATH="./config/ca.crt"

# JWT Secret (Optional - auto-generated if not provided)
# JWT_SECRET="your-jwt-signing-secret"

# Admin CORS Origin (Optional - defaults to http://localhost:5173)
# ADMIN_CORS_ORIGIN="http://localhost:5173"

# Testing
SKIP_INTEGRATION_TESTS="true"